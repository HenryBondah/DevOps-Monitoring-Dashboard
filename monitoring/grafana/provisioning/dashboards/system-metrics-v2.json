{
  "title": "System Metrics Overview v2",
  "tags": ["system", "metrics", "advanced"],
  "timezone": "browser",
  "refresh": "10s",
  "editable": true,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(node_cpu_seconds_total, instance)",
        "allValue": ".*",
        "includeAll": true,
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "label": "Instance"
      },
      {
        "name": "job",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(up, job)",
        "allValue": ".*",
        "includeAll": true,
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "label": "Job"
      },
      {
        "name": "interval",
        "type": "interval",
        "options": [
          { "value": "10s", "text": "10s" },
          { "value": "30s", "text": "30s" },
          { "value": "1m", "text": "1m" },
          { "value": "5m", "text": "5m" },
          { "value": "15m", "text": "15m" }
        ],
        "current": {
          "text": "1m",
          "value": "1m"
        },
        "label": "Interval"
      },
      {
        "name": "filesystem",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(node_filesystem_size_bytes, device)",
        "allValue": ".*",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "label": "Filesystem"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "⚙️ System Overview",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 1,
      "title": "CPU Usage (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\",instance=~\"$instance\"}[5m])) * 100)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 70, "color": "yellow" },
              { "value": 85, "color": "red" }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Memory Usage (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes{instance=~\"$instance\"} / node_memory_MemTotal_bytes{instance=~\"$instance\"})) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 60, "color": "yellow" },
              { "value": 80, "color": "orange" },
              { "value": 90, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "System Uptime",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "targets": [
        {
          "expr": "node_time_seconds{instance=~\"$instance\"} - node_boot_time_seconds{instance=~\"$instance\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "blue" }
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value"
      }
    },
    {
      "id": 101,
      "title": "🧠 CPU & Memory Details",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false
    },
    {
      "id": 10,
      "title": "CPU Core Breakdown",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "targets": [
        {
          "expr": "avg by(cpu) (irate(node_cpu_seconds_total{mode!=\"idle\",instance=~\"$instance\"}[5m])) * 100",
          "legendFormat": "Core {{cpu}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["mean", "lastNotNull", "max"]
        }
      }
    },
    {
      "id": 8,
      "title": "Process Count",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "targets": [
        {
          "expr": "node_procs_running{instance=~\"$instance\"}",
          "legendFormat": "Running",
          "refId": "A"
        },
        {
          "expr": "node_procs_blocked{instance=~\"$instance\"}",
          "legendFormat": "Blocked",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 102,
      "title": "💽 Disk & I/O",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false
    },
    {
      "id": 3,
      "title": "Disk Usage (%)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "targets": [
        {
          "expr": "(node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\",device=~\"$filesystem\",instance=~\"$instance\"} - node_filesystem_free_bytes{fstype!~\"tmpfs|overlay\",device=~\"$filesystem\",instance=~\"$instance\"}) / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\",device=~\"$filesystem\",instance=~\"$instance\"} * 100",
          "legendFormat": "{{mountpoint}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 70, "color": "yellow" },
              { "value": 85, "color": "orange" },
              { "value": 90, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 11,
      "title": "Disk I/O - Read",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "targets": [
        {
          "expr": "irate(node_disk_read_bytes_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 12,
      "title": "Disk I/O - Write",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "targets": [
        {
          "expr": "irate(node_disk_written_bytes_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 103,
      "title": "🌐 Network",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false
    },
    {
      "id": 4,
      "title": "Network Traffic",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "irate(node_network_receive_bytes_total{device!=\"lo\",instance=~\"$instance\"}[5m])",
          "legendFormat": "{{device}} RX",
          "refId": "A"
        },
        {
          "expr": "irate(node_network_transmit_bytes_total{device!=\"lo\",instance=~\"$instance\"}[5m])",
          "legendFormat": "{{device}} TX",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 13,
      "title": "Network Packet Loss",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        {
          "expr": "irate(node_network_receive_drop_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "{{device}} RX Drops",
          "refId": "A"
        },
        {
          "expr": "irate(node_network_transmit_drop_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "{{device}} TX Drops",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 104,
      "title": "🐳 Containers",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "collapsed": false
    },
    {
      "id": 14,
      "title": "Container CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 37 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{id=~\"/docker/.*\"}[5m])) by (id) * 100",
          "legendFormat": "{{id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^/docker/([a-f0-9]{12}).*",
            "renamePattern": "$1"
          }
        }
      ]
    },
    {
      "id": 15,
      "title": "Container Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 37 },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{id=~\"/docker/.*\"}",
          "legendFormat": "{{id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^/docker/([a-f0-9]{12}).*",
            "renamePattern": "$1"
          }
        }
      ]
    },
    {
      "id": 105,
      "title": "📊 System Load & Logs",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 45 },
      "collapsed": false
    },
    {
      "id": 5,
      "title": "System Load Average",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 46 },
      "targets": [
        {
          "expr": "node_load1{instance=~\"$instance\"}",
          "legendFormat": "1 min",
          "refId": "A"
        },
        {
          "expr": "node_load5{instance=~\"$instance\"}",
          "legendFormat": "5 min",
          "refId": "B"
        },
        {
          "expr": "node_load15{instance=~\"$instance\"}",
          "legendFormat": "15 min",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 5, "color": "yellow" },
              { "value": 10, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 16,
      "title": "Log Messages by Level",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 46 },
      "datasource": "Elasticsearch",
      "targets": [
        {
          "refId": "A",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "log_level.keyword",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_count"
              }
            },
            {
              "id": "3",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "auto"
              }
            }
          ],
          "query": "*",
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 5, "color": "yellow" },
              { "value": 10, "color": "red" }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "id": 6,
      "title": "System Logs (Live Feed)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 54 },
      "datasource": "Elasticsearch",
      "targets": [
        {
          "refId": "A",
          "metrics": [
            {
              "id": "1",
              "type": "logs"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": 0,
                "trimEdges": 0
              }
            }
          ],
          "query": "*",
          "timeField": "@timestamp"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      }
    }
  ],
  "annotations": {
    "list": [
      {
        "datasource": "Prometheus",
        "enable": true,
        "expr": "ALERTS{alertstate=\"firing\"}",
        "name": "Alerts",
        "tagKeys": "alertname",
        "textFormat": "{{alertname}}",
        "titleFormat": "Alert"
      }
    ]
  }
}
